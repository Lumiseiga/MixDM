{
  "name": "mixdm",
  "version": "1.3.0",
  "description": "A high-performance segmented download manager prototype",
  "main": "electron-main.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "desktop": "electron .",
    "electron": "electron .",
    "pack": "electron-builder --dir",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "basic-ftp": "^6.0.1",
    "better-sqlite3": "^12.10.0",
    "electron-updater": "^6.8.3",
    "express": "^4.18.2",
    "follow-redirects": "^1.15.5"
  },
  "keywords": [
    "download-manager",
    "segmented-download",
    "idm"
  ],
  "author": "MIXDM",
  "license": "MIT",
  "build": {
    "appId": "com.mixdm.app",
    "productName": "MIXDM",
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Lumiseiga",
        "repo": "mixdm"
      }
    ],
    "files": [
      "app-paths.js",
      "console-safe.js",
      "database.js",
      "downloader.js",
      "electron-main.js",
      "machine-id.js",
      "preload.js",
      "public/**/*",
      "reports-db.js",
      "safety.js",
      "src/**/*",
      "settings.js",
      "users-db.js",
      "ytdlp-engine.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "extension",
        "to": "extension",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^26.8.1"
  }
}
