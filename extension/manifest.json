{
  "manifest_version": 3,
  "name": "MIXDM Connector",
  "version": "1.3.0",
  "description": "Send pages, links, videos, and images to the local MIXDM download manager.",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "storage",
    "tabs",
    "webRequest",
    "cookies"
  ],
  "host_permissions": [
    "http://localhost:3737/*",
    "http://127.0.0.1:3737/*",
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Send to MIXDM",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": ["content-script.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
